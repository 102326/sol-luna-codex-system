# Credentials and local authentication
**/auth.json
**/*credentials*
**/*secret*
**/*token*
**/*.pem
**/*.key

# User-specific configuration snapshots and backups
**/*config.local.*
**/*config.user.*
**/*.bak
**/*.backup
**/backups/

# Logs, caches, temporary and generated files
**/*.log
**/logs/
**/.cache/
**/cache/
**/tmp/
**/temp/
**/.tmp/
**/.codex/backups/

# Local overrides if historical project settings are deliberately installed
.codex/config.local.toml
.codex/agents.local/
